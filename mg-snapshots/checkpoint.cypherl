CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11803, `key`: "j_jeff_yan", `name`: "j_jeff_yan", `desc`: "J. Jeff Yan is a researcher and author who has contributed to the field of online game security. His work involves analyzing and addressing the various security challenges present in online gaming environments.", `layer`: 0});
CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11804, `key`: "security_issues_in_online_games", `name`: "security_issues_in_online_games", `desc`: "\"Security issues in online games\" is a scholarly article that discusses the various security challenges and vulnerabilities present in online gaming environments. It explores vulnerabilities, threats, and potential solutions to enhance the security of online games, aiming to ensure a safer and more secure gaming experience for users. The article was published in *The Electronic Library* in April 2002 by J. Jeff Yan and H. Choi, contributing significantly to the understanding of cybersecurity in digital entertainment platforms.", `layer`: 0});
