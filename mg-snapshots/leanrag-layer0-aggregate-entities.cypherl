CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11163, `key`: "20_2", `name`: "20_2", `desc`: "The object \"20.2\" represents the volume number of the journal \"The Electronic Library\" in which the article \"Security issues in online games\" was published. This volume, issued in April 2002, contains a collection of articles on various topics related to electronic libraries and information systems, with the specific article on security issues in online games contributing to the broader discussion on digital security.", `layer`: 0});
CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11164, `key`: "apr_2002", `name`: "apr_2002", `desc`: "The object \"Apr. 2002\" specifies the month and year of publication for the article on security issues in online games. This date is significant as it provides a temporal context for the research, indicating when the study was conducted and the state of online gaming security at that time.", `layer`: 0});
