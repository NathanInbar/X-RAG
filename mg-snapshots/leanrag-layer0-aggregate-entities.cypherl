CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11200, `key`: "https_www_usenix_org_conference_usenixsecurity23_presentation_choi", `name`: "https_www_usenix_org_conference_usenixsecurity23_presentation_choi", `desc`: "The object https://www.usenix.org/conference/usenixsecurity23/presentation/choi is the URL that leads to the online presentation page for the research paper \"BotScreen: Trust Everybody, but Cut the Aimbots Yourself\" at the USENIX Security Symposium. This page likely contains the paper\'s abstract, authors\' information, and possibly a link to download the full paper or view the presentation.", `layer`: 0});
