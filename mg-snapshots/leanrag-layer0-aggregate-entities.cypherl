CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11190, `key`: "m_choi", `name`: "m_choi", `desc`: "M. Choi is a researcher and author specializing in cybersecurity, with a focus on maintaining integrity in online gaming environments. They co-authored the paper \"BotScreen: Trust Everybody, but Cut the Aimbots Yourself,\" which was presented at the 32nd USENIX Security Symposium in 2023. The paper introduces BotScreen, a tool designed to detect and neutralize aimbots, ensuring fair play in online games.", `layer`: 0});
CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11191, `key`: "g_ko", `name`: "g_ko", `desc`: "G. Ko is a researcher and co-author known for their contributions to cybersecurity, particularly in developing systems like BotScreen to enhance online gaming security. They have collaborated on research papers presented at significant conferences such as the 32nd USENIX Security Symposium.", `layer`: 0});
CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11192, `key`: "s_k_cha", `name`: "s_k_cha", `desc`: "S. K. Cha is a researcher and author in the field of computer security, known for his contributions to academic publications and presentations at significant security conferences. He has co-authored papers, including one on the BotScreen project, which aims to detect and mitigate cheating in online games. His work focuses on advancing gaming security technologies and presenting findings at events like the USENIX Security Symposium.", `layer`: 0});
CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11193, `key`: "botscreen_trust_everybody_but_cut_the_aimbots_yourself", `name`: "botscreen_trust_everybody_but_cut_the_aimbots_yourself", `desc`: "\"BotScreen: Trust Everybody, but Cut the Aimbots Yourself\" is a research paper by M. Choi, G. Ko, and S. K. Cha, presented at the 32nd USENIX Security Symposium. The paper introduces a security mechanism designed to detect and mitigate the use of aimbots in online gaming environments, promoting fair play and enhancing security.", `layer`: 0});
CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11194, `key`: "32nd_usenix_security_symposium_usenix_security_23", `name`: "32nd_usenix_security_symposium_usenix_security_23", `desc`: "The 32nd USENIX Security Symposium (USENIX Security 23) is an annual conference that brings together researchers, practitioners, and users to discuss the latest advances in security technologies, policies, and practices. It serves as a critical venue for presenting novel research, such as the BotScreen paper, and fostering discussions on emerging security challenges and solutions.", `layer`: 0});
CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11195, `key`: "anaheim_ca", `name`: "anaheim_ca", `desc`: "Anaheim, CA is a city in California, known for being the location of various conventions, including the USENIX Security Symposium. It is a hub for technological and security-related discussions and presentations.", `layer`: 0});
CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11196, `key`: "usenix_association", `name`: "usenix_association", `desc`: "The USENIX Association is a non-profit organization dedicated to advancing the state of the art in computing. It organizes conferences, publishes proceedings, and fosters collaboration among professionals in the field of computing and information technology.", `layer`: 0});
CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11197, `key`: "aug_2023", `name`: "aug_2023", `desc`: "Aug. 2023 refers to the month and year when the research paper titled \"BotScreen: Trust Everybody, but Cut the Aimbots Yourself\" was presented at the 32nd USENIX Security Symposium. This date signifies the timeliness and relevance of the research within the field of cybersecurity and online gaming integrity.", `layer`: 0});
CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11198, `key`: "481_498", `name`: "481_498", `desc`: "The object \"481–498\" represents the page numbers in the USENIX Security Symposium proceedings where the paper titled \"BotScreen: Trust Everybody, but Cut the Aimbots Yourself\" is located. Readers can find the detailed discussion, methodology, and findings of the research within these pages.", `layer`: 0});
