CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11250, `key`: "lstm_a_search_space_odyssey", `name`: "lstm_a_search_space_odyssey", `desc`: "\"LSTM: A Search Space Odyssey\" is a research paper by K. Greff, R. K. Srivastava, J. Koutnik, B. R. Steunebrink, and J. Schmidhuber, published in the IEEE Transactions on Neural Networks and Learning Systems. It explores Long Short-Term Memory (LSTM) networks, a type of recurrent neural network designed for sequence prediction problems, and investigates various configurations and optimizations within its search space.", `layer`: 0});
