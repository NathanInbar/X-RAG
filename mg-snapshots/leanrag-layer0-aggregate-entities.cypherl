CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11166, `key`: "0264_0473", `name`: "0264_0473", `desc`: "0264-0473 is the ISSN assigned to The Electronic Library, which is used to uniquely identify this specific journal in the global bibliographic system. This number is crucial for indexing, cataloging, and referencing the journal in academic and library databases.", `layer`: 0});
