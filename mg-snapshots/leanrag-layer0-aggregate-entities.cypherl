CREATE (:__mg_vertex__:`Entity` {__mg_id__: 11280, `key`: "papermc_documentation_player", `name`: "papermc_documentation_player", `desc`: "The PaperMC Documentation - Player is a comprehensive guide on the Player class within the Bukkit API, tailored for developers working on Minecraft server modifications using Bukkit or its enhanced fork, PaperMC. It offers detailed insights into interacting with player entities, including methods, fields, and practical usage in server development.", `layer`: 0});
